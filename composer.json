{
  "name": "victorstack-ai/wp-google-preferred-source",
  "description": "WordPress plugin to encourage users to add the site as a Google Preferred Source.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.4",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.3"
  },
  "autoload": {
    "classmap": ["class-wp-google-preferred-source.php"]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
